  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring.multi.python"],
      "settings": { "foreground": "#45454A", "fontStyle": "italic" }
    },
    {
      "name": "Keywords y storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.other", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "support.type.primitive", "support.type.builtin"],
      "settings": { "foreground": "#A178C4" }
    },
    {
      "name": "Control de flujo (italic)",
      "scope": ["keyword.control", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.flow", "keyword.control.conditional", "keyword.control.loop"],
      "settings": { "foreground": "#6EBAD7", "fontStyle": "italic" }
    },
    {
      "name": "Go declarations (type/func/var)",
      "scope": ["keyword.type.go", "keyword.function.go", "keyword.var.go", "keyword.struct.go", "keyword.const.go"],
      "settings": { "foreground": "#6EBAD7", "fontStyle": "" }
    },
    {
      "name": "Operadores y puntuacion",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.definition.string", "punctuation.definition.tag", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#6EBAD7" }
    },
    {
      "name": "Arrow function",
      "scope": ["storage.type.function.arrow"],
      "settings": { "foreground": "#A178C4" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw", "constant.other.symbol"],
      "settings": { "foreground": "#A3C679" }
    },
    {
      "name": "Escapes, placeholders e interpolacion",
      "scope": ["constant.character.escape", "constant.other.placeholder", "constant.character.format.placeholder"],
      "settings": { "foreground": "#C85E60" }
    },
    {
      "name": "Interpolacion ${}",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#6EBAD7" }
    },
    {
      "name": "Numeros y constantes",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "keyword.other.unit"],
      "settings": { "foreground": "#CD775C" }
    },
    {
      "name": "Booleanos y null",
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#6EBAD7" }
    },
    {
      "name": "Rust fn/impl/mod",
      "scope": ["keyword.other.fn.rust", "storage.type.rust", "keyword.other.rust", "storage.type.function.rust"],
      "settings": { "foreground": "#CD775C" }
    },
    {
      "name": "Funciones",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function", "entity.name.function.macro"],
      "settings": { "foreground": "#6A90D0" }
    },
    {
      "name": "Clases, tipos, interfaces",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#D5B05F" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable", "entity.name.variable"],
      "settings": { "foreground": "#D9D9D9" }
    },
    {
      "name": "Parametros y self/this",
      "scope": ["variable.parameter", "variable.language", "variable.language.self", "variable.language.this", "variable.parameter.function.language.special.self.python"],
      "settings": { "foreground": "#D9D9D9", "fontStyle": "italic" }
    },
    {
      "name": "Tags HTML/JSX",
      "scope": ["entity.name.tag", "support.class.component", "meta.tag.sgml"],
      "settings": { "foreground": "#C85E60" }
    },
    {
      "name": "Componentes JSX",
      "scope": ["support.class.component.tsx", "support.class.component.jsx", "entity.name.tag.tsx", "entity.name.tag.jsx"],
      "settings": { "foreground": "#D5B05F" }
    },
    {
      "name": "Atributos",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"],
      "settings": { "foreground": "#A178C4" }
    },
    {
      "name": "CSS selectores",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "keyword.other.universal.css"],
      "settings": { "foreground": "#D5B05F" }
    },
    {
      "name": "CSS propiedades",
      "scope": ["support.type.property-name", "meta.property-name", "support.type.vendored.property-name"],
      "settings": { "foreground": "#90A9BC" }
    },
    {
      "name": "CSS valores",
      "scope": ["support.constant.property-value", "support.constant.font-name", "meta.property-value"],
      "settings": { "foreground": "#D9D9D9" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "meta.object-literal.key"],
      "settings": { "foreground": "#90A9BC" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#39EA5F", "fontStyle": "bold" }
    },
    {
      "name": "Markdown enfasis",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#D5B05F", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#A178C4", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#6A90D0" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#45454A", "fontStyle": "italic" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#A3C679" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#C85E60" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#6A90D0" }
    },
    {
      "name": "Invalido",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C85E60" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#D5B05F",
    "class": "#D5B05F",
    "enum": "#D5B05F",
    "interface": "#D5B05F",
    "struct": "#D5B05F",
    "type": "#D5B05F",
    "typeParameter": "#D5B05F",
    "function": "#6A90D0",
    "method": "#6A90D0",
    "macro": "#6A90D0",
    "decorator": "#D5B05F",
    "parameter": { "foreground": "#D9D9D9", "italic": true },
    "variable": "#D9D9D9",
    "property": "#D9D9D9",
    "enumMember": "#CD775C",
    "variable.readonly.defaultLibrary": "#CD775C",
    "selfKeyword": { "foreground": "#D9D9D9", "italic": true }
  }
}
